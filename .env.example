# Copy to .env locally; never commit .env. The application loads .env at startup.
DEEPSEEK_API_KEY=
# Confirmed against the official model documentation during implementation.
PATCHTRAIL_MODEL=deepseek-flash
PATCHTRAIL_MODEL_BASE_URL=https://api.deepseek.com
# Set a long random operator token before exposing live-run/approval controls.
PATCHTRAIL_ADMIN_TOKEN=
PATCHTRAIL_DATA_DIR=var
PATCHTRAIL_CONTAINER_BIN=docker
PATCHTRAIL_CONTAINER_IMAGE=python:3.12-slim
PATCHTRAIL_PUBLIC_DEMO=true

# Optional: fixed local image ID for the prepared pytest profile. Never fetched by a run.
PATCHTRAIL_PYTEST_IMAGE=
