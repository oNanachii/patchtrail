# Build only during deployment preparation, never from an execution request.
ARG BASE_IMAGE=docker.io/library/python@sha256:1148dbb014615300fa7e713b2f94f550c0d1c69780c0805f84f093ceee34dd0b
FROM ${BASE_IMAGE}
COPY requirements.lock.txt /tmp/patchtrail-pytest-requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: --no-deps -r /tmp/patchtrail-pytest-requirements.txt \
    && python -m pip check \
    && rm /tmp/patchtrail-pytest-requirements.txt
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PYTEST_ADDOPTS=
RUN python -I -B -m pytest --version
USER 65534:65534
WORKDIR /workspace
