# Operator-managed file, mode 0600, outside Git and all verifier workspaces.
# Install as /var/lib/patchtrail/.config/patchtrail/patchtrail.env.
DEEPSEEK_API_KEY=
PATCHTRAIL_MODEL=deepseek-flash
PATCHTRAIL_MODEL_BASE_URL=https://api.deepseek.com
PATCHTRAIL_ADMIN_TOKEN=
PATCHTRAIL_DATA_DIR=/var/lib/patchtrail/data
PATCHTRAIL_CONTAINER_BIN=/usr/bin/podman
# Replace this tag with the fully qualified RepoDigest from the reviewed pull.
# The running application must use --pull=never and never fetch an image.
PATCHTRAIL_CONTAINER_IMAGE=docker.io/library/python:3.12-slim
PATCHTRAIL_PUBLIC_DEMO=true

# Optional: fixed local image ID for the prepared pytest profile. Never fetched by a run.
PATCHTRAIL_PYTEST_IMAGE=
