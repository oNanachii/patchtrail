name: Runtime and container checks
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 12
    env:
      PATCHTRAIL_CONTAINER_BIN: docker
      PATCHTRAIL_CONTAINER_IMAGE: docker.io/library/python@sha256:1148dbb014615300fa7e713b2f94f550c0d1c69780c0805f84f093ceee34dd0b
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements.lock.txt
      - run: node --check web/app.js
      - run: python -m unittest discover -s tests -v
      - name: Preload pinned verifier image
        run: docker pull "$PATCHTRAIL_CONTAINER_IMAGE"
      - name: Scripted actions through actual containers
        run: python scripts/verify_container.py --output artifacts/ci-container-integration.json
